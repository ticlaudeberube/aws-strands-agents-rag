# Deployment Mode
# Selects which backends the app wires up:
#   local      -> Ollama + vector DB (currently Milvus) + FastAPI (default; no AWS required)
#   serverless -> Bedrock + OpenSearch + Lambda (AWS)
# This is the single source of truth for mode switching.
DEPLOYMENT_MODE=local

# Local Mode vector store (only used when DEPLOYMENT_MODE=local):
#   milvus     -> Ollama + Milvus (default; the existing local stack)
#   opensearch -> Ollama + local OpenSearch container (prod parity)
# Serverless mode always uses OpenSearch Serverless and ignores this.
LOCAL_VECTOR_BACKEND=milvus
# Local OpenSearch container connection (plain HTTP, security disabled). Only
# used when LOCAL_VECTOR_BACKEND=opensearch. Start the container with:
#   docker compose -f docker/docker-compose.yml --profile opensearch up -d opensearch
OPENSEARCH_LOCAL_HOST=localhost
OPENSEARCH_LOCAL_PORT=9200

# Ollama Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_EMBED_MODEL=nomic-embed-text:v1.5

# Vector DB Configuration.
# The runtime app (src/) uses OpenSearch (see OPENSEARCH_* / LOCAL_VECTOR_BACKEND
# below). These MILVUS_* connection variables now only configure the standalone
# document_loaders/ ingestion utility (its own local_settings.py); they are not
# read by the runtime application.
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_DB_NAME=knowledge_base
LOADER_MILVUS_DB_NAME=knowledge_base

# Vector index tuning (engine-agnostic — applies to BOTH backends).
# Use the VECTORDB_* names. The deprecated MILVUS_* aliases have been removed.
# Index type: HNSW (speed-optimized), IVF_FLAT, FLAT
VECTORDB_INDEX_TYPE=HNSW
# Similarity metric: COSINE, L2, IP
VECTORDB_METRIC_TYPE=COSINE
# HNSW max connections per element (graph connectivity)
VECTORDB_HNSW_M=30
# HNSW construction quality (>M, typically 2x-4x M)
VECTORDB_HNSW_EF_CONSTRUCTION=200
# IVF_FLAT clusters (typical: 128-1024)
VECTORDB_IVF_NLIST=128
# HNSW search-time beam width (ef): higher = better recall, slower. Clamped to
# at least top_k. Shared by BOTH backends — it also sets ef_search on the
# serverless OpenSearch k-NN query so recall tuning stays consistent.
VECTORDB_SEARCH_EF=64

# Collection Names
# Existing default collection name is preserved for compatibility with current local data.
OLLAMA_COLLECTION_NAME=milvus_rag_collection
# Collection for cached Q&A pairs (phase 3C)
RESPONSE_CACHE_COLLECTION_NAME=response_cache

# Performance Settings
# Run benchmark/ollama-threads-check.py to get optimal thread number
OLLAMA_NUM_THREADS=6
TOKENIZERS_PARALLELISM=false
PYTORCH_MPS_HIGH_WATERMARK_RATIO=0.0

# Embedding and chunk processing
MAX_CHUNK_LENGTH=400
EMBEDDING_DIM=768
# Must match ollama_embed_model dimension (nomic-embed-text:v1.5 = 768)
RESPONSE_CACHE_EMBEDDING_DIM=768
# Maximum tokens for LLM responses (API/default generation cap)
MAX_TOKENS=2000
# Application settings
BATCH_SIZE=10
LOG_LEVEL=INFO

# API Server Configuration
API_PORT=8000

# Cache Configuration
# Enable/disable response cache warmup on startup (pre-loads Q&A pairs from data/responses.json)
# Set to false to skip cache warmup in development/testing
ENABLE_CACHE_WARMUP=true
# Semantic cache similarity threshold (0-1). Higher = stricter cache hits.
# settings.py default is 0.92; this example uses 0.99 for near-exact matches.
RESPONSE_CACHE_THRESHOLD=0.99
# Maximum number of cached responses to retrieve for statistics (higher = more expensive queries)
RESPONSE_CACHE_STATS_LIMIT=10000

# Retrieval Tuning Parameters (Phase 3B)
DEFAULT_TOP_K=10                        # Default number of context chunks for retrieval (typical: 5-15)
SEARCH_COMPARISON_TOP_K=2               # Top-k for product comparison searches (optimized for speed)
EMBEDDING_CACHE_TTL=3600                # Embedding cache time-to-live in seconds (3600 = 1 hour)

# Web Search Configuration
# Timeout for web search requests in seconds
# Add web search results as supplementary sources to KB results (default: OFF)
# Note: Old strands_rag_agent.py had web search always ON.
# New graph agent uses feature flag for safety - set to true to enable web search.
# When enabled, web search results appear as supplementary sources alongside KB sources in the UI.
WEB_SEARCH_TIMEOUT=10
# KB relevance threshold (0-1) to trigger web search fallback (default: 0.15 = 15%)
# If average KB relevance is below this threshold, web search results are automatically added
# Set to 0.0 to always use web search, 1.0 to never use web search fallback
# 0.15 is restrictive - only fallbacks when KB truly has no good content (was 0.5)
WEB_SEARCH_FALLBACK_THRESHOLD=0.15
# Master toggle: add web search results as supplementary KB sources (default off).
# This is the flag that actually gates web search; leave false to disable.
ENABLE_WEB_SEARCH_SUPPLEMENT=false
# Anti-hallucination post-generation gate (Layer 3). Min fraction (0-1) of an
# answer's content words that must appear in sources before the low-grounding
# caveat fires. See docs/ANTI_HALLUCINATION.md.
ANSWER_GROUNDING_THRESHOLD=0.35
# Heuristic-confidence floor (0-1) before the low-confidence caveat fires
# (only when grounding passed). See docs/ANTI_HALLUCINATION.md.
ANSWER_CONFIDENCE_THRESHOLD=0.45
# Empty-Answer Web Search Triggering
# Questions with empty answers in data/responses.json automatically trigger web search
# Example in responses.json:
#   {"question": "What is the latest vector database news?", "answer": "", "sources": []}
# When cache hits this entry, it detects the empty answer and triggers web search for fresh results
# This is useful for news/trends/updates type questions that need current information
# Get free API key from https://tavily.com (leave empty to disable web search)
TAVILY_API_KEY=
# Anti-hallucination: grounding retry (soft steer)
# When a KB answer fails the grounding check, retry retrieval once with a
# widened top_k before applying the low-grounding caveat. See
# docs/ANTI_HALLUCINATION.md (Layer 3). Set to false to disable the retry.
GROUNDING_RETRY_ENABLED=true
# Factor applied to top_k on the retry (capped at 50). 1 disables widening.
GROUNDING_RETRY_TOP_K_MULTIPLIER=2

# Runtime-tunable thresholds (serverless only). DynamoDB table whose rows
# override the anti-hallucination thresholds above at Lambda cold start, so
# operators can retune without a redeploy. Leave unset to always use the
# values in this file / settings.py. See docs/ANTI_HALLUCINATION.md.
# DYNAMODB_THRESHOLDS_TABLE=strands-rag-dev-thresholds

# HTTP Configuration
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/111.0.0.0 Safari/537.36

# AWS Configuration (optional, for agent reasoning with Bedrock)
AWS_REGION=us-west-1
# Uncomment and set if using AWS services
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key

# MLflow Evaluation Harness (scripts/eval_local.py — dev/CI tool only)
# Where the offline RAG eval logs its runs and GenAI traces. Only read by the
# eval harness; the app ignores it. Resolution order in the harness:
#   --tracking-uri flag  ->  MLFLOW_TRACKING_URI (this var)  ->  ./mlruns
# Set this to a running MLflow server to get the GenAI Traces view, e.g.:
#   MLFLOW_TRACKING_URI=http://127.0.0.1:5000
# Or a single-file SQLite store (no server needed): sqlite:///mlflow.db
# Leave unset/blank to use the default local ./mlruns file store.
# MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# Backend Input Validation (API Server)
# Minimum message length (backend validation)
MIN_MESSAGE_LENGTH=2
# Maximum message length (backend DoS protection). settings.py default is 5000;
# this example caps at 200 for a tighter demo limit — raise it for longer queries.
MAX_MESSAGE_LENGTH=200
# Enable HTML sanitization using bleach library
ENABLE_HTML_SANITIZATION=true

# ============================================================================
# Serverless Mode Configuration (only used when DEPLOYMENT_MODE=serverless)
# ============================================================================
# All values below have safe defaults and can be left blank for local mode.

# Bedrock (LLM inference + embeddings)
# Default inference model (Claude 3 Haiku)
BEDROCK_INFERENCE_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
# Embedding model (Titan Embed v1, 1536-dim -> reduced to 768-dim via PCA)
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v1
# Optional override for the inference model (production tuning without code changes)
BEDROCK_MODEL_OVERRIDE=
# Raw embedding dimension returned by the Bedrock embedding model (Titan v1 = 1536)
BEDROCK_EMBEDDING_DIM=1536
# Target dimension after PCA reduction, matching the 768-dim OpenSearch k-NN index
BEDROCK_PCA_TARGET_DIM=768
# Optional pre-computed PCA projection matrix (s3://bucket/key.npy or local .npy).
# When unset, a deterministic built-in projection is used.
BEDROCK_PCA_MATRIX_URI=

# OpenSearch Serverless (vector store + Layer 4 semantic cache)
# Collection endpoint (HTTPS, VPC-only)
OPENSEARCH_ENDPOINT=
# Knowledge base documents index
OPENSEARCH_KB_INDEX=rag-kb
# Layer 4 semantic response cache index
OPENSEARCH_CACHE_INDEX=rag-cache

# ElastiCache Redis (Layer 2 embedding cache / Layer 3 search result cache)
REDIS_ENDPOINT=
# Layer 2 embedding cache TTL in seconds (default 1 hour)
REDIS_EMBEDDING_TTL=3600
# Layer 3 search result cache TTL in seconds (default 24 hours)
REDIS_SEARCH_TTL=86400

# DynamoDB (session history + indexing analytics)
# Session table (conversation history, TTL 24h)
DYNAMODB_SESSION_TABLE=
# Analytics table (per-query / indexing analytics)
DYNAMODB_ANALYTICS_TABLE=

# AgentCore distributed cache + session analytics (optional, serverless)
# Enable a Redis distributed cache for AgentCore (alternative wiring to the
# ElastiCache endpoint above).
REDIS_CACHE_ENABLED=false
REDIS_HOST=
REDIS_PORT=6379
REDIS_DB=0
# Embedding (L2) and search-result (L3) cache TTLs, in HOURS, for the
# AgentCore distributed cache path.
EMBEDDING_CACHE_TTL_HOURS=1
SEARCH_CACHE_TTL_HOURS=24
# Use DynamoDB (instead of Redis) as the distributed cache backend.
USE_DYNAMODB_CACHE=false
DYNAMODB_CACHE_TABLE=
# DynamoDB table for AgentCore session analytics, and the toggle that enables
# per-question analytics writes.
AGENTCORE_SESSION_TABLE=
ENABLE_QUESTION_ANALYTICS=false

# Secrets Manager (secret names/ARNs resolved at Lambda cold start)
# Secret holding the Tavily API key
SECRETS_TAVILY_API_KEY=
# Secret holding Redis credentials
SECRETS_REDIS_CREDENTIALS=
