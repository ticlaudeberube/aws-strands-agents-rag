# Environment for running SERVERLESS MODE locally (Option A).
#
# Load it with:  set -a && source .env.serverless-local && set +a
# or let scripts/run_serverless_local.py read it via python-dotenv.
#
# Real Bedrock is used (account 996428372683, us-east-1). OpenSearch and Redis
# are the local Docker containers in docker/serverless-local/docker-compose.yml;
# the runner injects clients pointed at them (the production clients assume
# AOSS TLS/SigV4 + ElastiCache TLS, which local containers don't speak).

DEPLOYMENT_MODE=serverless
AWS_REGION=us-east-1

# --- Bedrock -------------------------------------------------------------
# claude-3-haiku-20240307 is end-of-life, and newer Anthropic models need the
# one-time Anthropic use-case (FTU) form. Amazon Nova needs no FTU form and
# works today via the Converse API. Swap this to
# us.anthropic.claude-haiku-4-5-20251001-v1:0 once the FTU form is submitted.
BEDROCK_MODEL_OVERRIDE=amazon.nova-lite-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v1

# --- Local OpenSearch (stand-in for OpenSearch Serverless) ---------------
# Informational; the runner builds the injected client from OPENSEARCH_LOCAL_*.
OPENSEARCH_ENDPOINT=http://localhost:9200
OPENSEARCH_KB_INDEX=rag-kb
OPENSEARCH_CACHE_INDEX=rag-cache
OPENSEARCH_LOCAL_HOST=localhost
OPENSEARCH_LOCAL_PORT=9200

# --- Local Redis (stand-in for ElastiCache) ------------------------------
REDIS_ENDPOINT=localhost:6379

# --- Local DynamoDB (stand-in for the serverless session/analytics tables)
# The runner/shim build a boto3 resource pointed at DYNAMODB_LOCAL_ENDPOINT and
# create these tables on startup. Session history (per-session conversation,
# 24h TTL) is what the real Lambda handler loads/persists.
DYNAMODB_SESSION_TABLE=strands-rag-local-sessions
DYNAMODB_ANALYTICS_TABLE=strands-rag-local-analytics
DYNAMODB_LOCAL_ENDPOINT=http://localhost:8001

# --- Web search (Tavily) -------------------------------------------------
# In serverless mode the Tavily key normally comes from AWS Secrets Manager
# (SECRETS_TAVILY_API_KEY). We intentionally leave that UNSET so the resolver
# falls back to the plain TAVILY_API_KEY env var below — no Secrets Manager
# needed for local testing. Set TAVILY_API_KEY to your key (get one free at
# https://tavily.com). The force-web-search toggle in the GUI uses this.
ENABLE_WEB_SEARCH_SUPPLEMENT=true
TAVILY_API_KEY=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
