    "terraform": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "TFE_TOKEN",
        "hashicorp/terraform-mcp-server"
      ],
      "env": {
        "TFE_TOKEN": "${TFE_TOKEN}"
      },
      "disabledTools": [
        "add_team_member",
        "attach_policy_set_to_workspaces",
        "attach_variable_set_to_workspaces",
        "create_no_code_workspace",
        "create_project",
        "create_run",
        "create_team",
