        "grant_team_access",
        "list_runs",
        "list_stacks",
        "list_state_versions",
        "list_teams",
        "list_terraform_orgs",
        "list_terraform_projects",
        "list_variable_sets",
        "list_workspace_policy_sets",
        "list_workspace_variables",
        "list_workspaces",
        "read_workspace_tags",
        "search_modules",
