# =============================================================================
# React Chatbot environment configuration
# =============================================================================
# This single React source serves BOTH deployment modes. Which variables you
# set decides the mode:
#   * Local dev (default)   -> leave the serverless vars below UNSET.
#   * Serverless (AWS)      -> set REACT_APP_API_URL + the Cognito vars.

# -----------------------------------------------------------------------------
# LOCAL DEV API server (used only when REACT_APP_API_URL is NOT set)
# -----------------------------------------------------------------------------
REACT_APP_API_PORT=8000
REACT_APP_API_HOST=localhost

# -----------------------------------------------------------------------------
# SERVERLESS API URL (Requirement 8.4)
# -----------------------------------------------------------------------------
# Full HTTPS API Gateway base URL. When set, it is used VERBATIM and the
# localhost host/port fallback above is ignored. Leaving it unset keeps local
# dev behaving exactly as before. Example:
# REACT_APP_API_URL=https://abc123.execute-api.us-east-1.amazonaws.com/prod

# -----------------------------------------------------------------------------
# COGNITO AUTH (serverless mode only — Requirements 7.4, 7.5)
# -----------------------------------------------------------------------------
# Auth is enabled when REACT_APP_AUTH_ENABLED=true OR when a user pool id is
# present. Leave these unset for local dev (no auth).
# REACT_APP_AUTH_ENABLED=true
# REACT_APP_USER_POOL_ID=us-east-1_xxxxxxxxx
# REACT_APP_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# REACT_APP_AWS_REGION=us-east-1

# -----------------------------------------------------------------------------
# Frontend input validation (React UI)
# -----------------------------------------------------------------------------
REACT_APP_MIN_MESSAGE_LENGTH=2        # Minimum message length (immediate user feedback)
REACT_APP_MAX_MESSAGE_LENGTH=1000     # Maximum message length (reasonable for most questions)
# Note: HTML sanitization is always enabled in frontend (DOMPurify) - no toggle needed for security
